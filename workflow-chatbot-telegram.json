        [
          { "node": "Formatar Mensagem", "type": "main", "index": 0 }
        ],
        [
          { "node": "Enviar Erro", "type": "main", "index": 0 }
        ]
      ]
    },
    "Formatar Mensagem": {
      "main": [
        [
          { "node": "Enviar Temperatura", "type": "main", "index": 0 }
        ]
      ]
    }
  },
